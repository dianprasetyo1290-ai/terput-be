# notification-service — port 8089, db teratai_notification
# (standalone single-service dev stack; the root docker-compose wires the
# service into the full Teratai stack).

# --- service ---
PORT=8089
APP_ENV=development
DATABASE_URL=postgres://teratai:change-me@localhost:5489/teratai_notification?sslmode=disable

# Shared across the Go services; must match identity-service's signing secret.
# In production these MUST be set explicitly and must not carry a "dev-" /
# "change-me" marker, or the service refuses to start.
SEKOCI_JWT_SECRET=change-me
SEKOCI_INTERNAL_KEY=change-me

# Frontend dev-server origins allowed to call the service.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Outbound delivery adapter for email/whatsapp:
#   dev          -> no-op, logs only (forbidden in production)
#   noop         -> explicit no-op
#   unconfigured -> refuses every send (production default until wired)
NOTIFICATION_PROVIDER=dev

# Sibling services (service-to-service calls use X-Internal-Key above).
IDENTITY_URL=http://localhost:8081

# Error tracking (optional; empty disables it).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- docker-compose.yml-only vars (standalone dev stack) ---
POSTGRES_USER=teratai
POSTGRES_PASSWORD=change-me
DB_NAME=teratai_notification
DB_HOST_PORT=5489
