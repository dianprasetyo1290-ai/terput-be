PORT=8084
DATABASE_URL=postgres://sekoci:change-me@localhost:5484/skci_exam?sslmode=disable
SEKOCI_JWT_SECRET=change-me
SEKOCI_INTERNAL_KEY=change-me
IDENTITY_URL=http://localhost:8081
ACADEMIC_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# HMAC key signing the short-lived, exam-scoped JWT an ADMISSION APPLICANT uses
# on /participant/** (see internal/common/participant_auth.go). Deliberately a
# DIFFERENT secret from SEKOCI_JWT_SECRET: the applicant routes must never
# accept (or be accepted by) the user-JWT routes. Unset -> the committed dev
# default; APP_ENV=production (or SENTRY_ENVIRONMENT=production) refuses that
# default, so real deployments MUST set this.
EXAM_PARTICIPANT_SECRET=change-me
# Applied as the handler default when a participant-access request omits
# ttl_seconds; the request may lower it but never raise it above 3600.
PARTICIPANT_TOKEN_TTL_SECONDS=900
# "production" activates the production-only config guards (see config.Validate).
APP_ENV=development

# docker-compose.yml-only vars (standalone single-service dev stack).
POSTGRES_USER=sekoci
POSTGRES_PASSWORD=change-me
DB_NAME=skci_exam
DB_HOST_PORT=5484
