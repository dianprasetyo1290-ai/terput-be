# attendance-service — port 8083, db skci_attendance (see docs/CONVENTIONS.md)

PORT=8083

# host-side default (docker-compose maps postgres -> localhost:5483, per the
# "54" + last-two-digits-of-port rule in CONVENTIONS.md). When running the
# Go binary *inside* docker-compose, this is overridden to use the `postgres`
# service hostname instead — see docker-compose.yml.
DATABASE_URL=postgres://sekoci:change-me@localhost:5483/skci_attendance?sslmode=disable

# shared across all 6 services, must match identity-service's signing secret
SEKOCI_JWT_SECRET=change-me

# shared service-to-service header value
SEKOCI_INTERNAL_KEY=change-me

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# sibling services, for best-effort name/roster/schedule enrichment.
# IDENTITY_SERVICE_URL is also required by the Portal Orang Tua (wali)
# endpoint: it calls identity's internal guardian-access check. If it is
# unset the wali endpoint fails CLOSED (denies), it never falls open.
IDENTITY_SERVICE_URL=http://localhost:8081
ACADEMIC_SERVICE_URL=http://localhost:8082
# P4A: alpa / leave notifications, core Approval Center (koreksi presensi
# setelah kunci) + audit trail, and the base URL core calls back on
# (/internal/approval-callbacks).
NOTIFICATION_SERVICE_URL=http://localhost:8089
CORE_URL=http://localhost:8091
ATTENDANCE_PUBLIC_INTERNAL_URL=http://localhost:8083

# docker-compose.yml-only vars (standalone single-service dev stack).
POSTGRES_USER=sekoci
POSTGRES_PASSWORD=change-me
DB_NAME=skci_attendance
DB_HOST_PORT=5483
