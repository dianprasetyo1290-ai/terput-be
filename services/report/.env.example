PORT=8086
DATABASE_URL=postgres://sekoci:change-me@localhost:5486/skci_report?sslmode=disable
SEKOCI_JWT_SECRET=change-me
SEKOCI_INTERNAL_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Sibling services this service aggregates from (internal HTTP calls, see
# README "Expected upstream contracts"). Point these at wherever each
# sibling is actually running — bare `go run` on the host uses localhost;
# via docker compose from another container use host.docker.internal.
IDENTITY_SERVICE_URL=http://localhost:8081
ACADEMIC_SERVICE_URL=http://localhost:8082
ATTENDANCE_SERVICE_URL=http://localhost:8083
EXAM_SERVICE_URL=http://localhost:8084

# docker-compose.yml-only vars (standalone single-service dev stack).
POSTGRES_USER=sekoci
POSTGRES_PASSWORD=change-me
DB_NAME=skci_report
DB_HOST_PORT=5486
