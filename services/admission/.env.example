# --- admission-service (Teratai PPDB + portal wali) ---
# Copy to `.env` and run `go run ./cmd/server` against the compose database,
# or `docker compose up -d --build` (which supplies its own working defaults).

# Service
PORT=8088
APP_ENV=development
DATABASE_URL=postgres://teratai:change-me@localhost:5487/teratai_admission?sslmode=disable

# Auth secrets. In production these MUST be set explicitly and must not carry a
# "dev-" / "change-me" marker (config.Load fails fast otherwise).
SEKOCI_JWT_SECRET=change-me
# Guardian session secret — deliberately different from the identity JWT secret.
ADMISSION_GUARDIAN_JWT_SECRET=change-me
SEKOCI_INTERNAL_KEY=change-me

# Frontend dev-server origins allowed to call the service.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# OTP delivery: "dev" logs codes to stdout and is forbidden in production.
OTP_PROVIDER=dev
OTP_TTL=5m
OTP_COOLDOWN=1m
OTP_MAX_ATTEMPTS=5
GUARDIAN_SESSION_TTL=12h

# Private upload storage (never served directly; streamed through authorized
# endpoints). Keep it on a persistent volume in production.
STORAGE_ROOT=./data/private
MAX_UPLOAD_BYTES=10485760

# Tenant + public branding for the unauthenticated PPDB catalogue. The public
# SPA sends no school_id, so it is pinned to Teratai Putih Global School.
# Leaving it empty guesses from the newest open period, which picks the
# SD/SMK unit once their PPDB periods exist.
ADMISSION_SCHOOL_ID=11111111-1111-1111-1111-111111111111
SCHOOL_NAME=Sekolah Teratai
SCHOOL_HEADLINE=Penerimaan Peserta Didik Baru
SCHOOL_DESCRIPTION=Temukan jalur pendaftaran, siapkan dokumen, dan pantau seluruh proses PPDB dalam satu portal.
SCHOOL_CONTACT=

# Downstream services (service-to-service calls use X-Internal-Key above).
IDENTITY_URL=http://localhost:8081
EXAM_URL=http://localhost:8084
ACADEMIC_URL=http://localhost:8082
# Browser-facing CBT entry base URL; leave empty to only provision the token.
EXAM_PUBLIC_URL=

# Error tracking (optional; empty disables it).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- docker-compose.yml-only vars (standalone single-service dev stack) ---
POSTGRES_USER=teratai
POSTGRES_PASSWORD=change-me
DB_NAME=teratai_admission
DB_HOST_PORT=5487
