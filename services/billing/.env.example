# --- billing-service (Teratai SPP / tagihan sekolah + Portal Orang Tua) ---
# Copy to `.env` and run `go run ./cmd/server` against the compose database,
# or `docker compose up -d --build` (which supplies its own working defaults).

# Service
PORT=8090
APP_ENV=development
DATABASE_URL=postgres://teratai:change-me@localhost:5490/teratai_billing?sslmode=disable

# Auth secrets. In production these MUST be set explicitly and must not carry a
# "dev-" / "change-me" marker (config.Load fails fast otherwise).
SEKOCI_JWT_SECRET=change-me
SEKOCI_INTERNAL_KEY=change-me

# Frontend dev-server origins allowed to call the service.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Private transfer-proof storage (never served directly; streamed through
# authorized endpoints). Keep it on a persistent volume in production.
STORAGE_ROOT=./data/private
MAX_UPLOAD_BYTES=10485760

# Downstream services (service-to-service calls use X-Internal-Key above).
# identity verifies guardian -> student ownership on every parent request.
IDENTITY_URL=http://localhost:8081
ACADEMIC_URL=http://localhost:8082

# Error tracking (optional; empty disables it).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- docker-compose.yml-only vars (standalone single-service dev stack) ---
POSTGRES_USER=teratai
POSTGRES_PASSWORD=change-me
DB_NAME=teratai_billing
DB_HOST_PORT=5490

# NICEPay SNAP Payment Gateway (T6)
# Leave empty for mock simulation during local testing, or configure for sandbox.
NICEPAY_BASE_URL=
NICEPAY_CLIENT_ID=
NICEPAY_CHANNEL_ID=
NICEPAY_CLIENT_SECRET=
NICEPAY_PRIVATE_KEY=
NICEPAY_PUBLIC_KEY=
NICEPAY_STORE_ID=
NICEPAY_CALLBACK_URL=
NICEPAY_RETURN_URL=
NICEPAY_IMAGE_URL=
# T14 payment extensions: other providers read their credentials from
# <credential_ref>_* (e.g. a second NICEPay merchant NICEPAY2_BASE_URL, ...),
# injected by the secret manager; never stored in the DB. Simulator switches
# only work outside production.
PAYMENT_SIM_FAIL_CHARGES=false
PAYMENT_SIM_FAIL_DEBITS=false
GATEWAY_JOURNAL_LOOKBACK_DAYS=7
