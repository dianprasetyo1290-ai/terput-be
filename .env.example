# Root env file for `docker compose up` at the repo root — Docker Compose
# loads this automatically (same directory as docker-compose.yml). Copy to
# `.env` and change the *_SECRET / *_PASSWORD values for anything beyond
# local dev; nothing in docker-compose.yml hardcodes these — see
# docs/CONVENTIONS.md.

# Shared Postgres instance (one server, 6 databases — see db-init/).
POSTGRES_USER=sekoci
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5480

# Per-service database names inside the shared instance.
IDENTITY_DB_NAME=skci_identity
ACADEMIC_DB_NAME=skci_academic
ATTENDANCE_DB_NAME=skci_attendance
EXAM_DB_NAME=skci_exam
EVALUATION_DB_NAME=skci_evaluation
REPORT_DB_NAME=skci_report

# Shared JWT + service-to-service auth (see docs/CONVENTIONS.md "Auth").
SEKOCI_JWT_SECRET=change-me
SEKOCI_INTERNAL_KEY=change-me

# Frontend dev-server origins allowed to call every service (one per
# domain agent's assigned port, see docs/FRONTEND_CONVENTIONS.md).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Service ports.
IDENTITY_PORT=8081
ACADEMIC_PORT=8082
ATTENDANCE_PORT=8083
EXAM_PORT=8084
EVALUATION_PORT=8085
REPORT_PORT=8086

# Error tracking (see docs/CONVENTIONS.md "Error tracking") — empty by
# default (Sentry SDK no-ops with an empty DSN), same value shared by all
# services; set a real DSN here once you have a Sentry project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Accounting Service (Laravel, served under /accounting/ by `web`).
# It also reads the shared SEKOCI_JWT_SECRET + SEKOCI_INTERNAL_KEY above: the
# former verifies the SSO token, the latter authenticates its feature-flag call
# to identity. Same values as the Go services -- do not duplicate under a new
# name. Its database is multi-tenant: one Postgres SCHEMA per school inside
# ACCOUNTING_DB_NAME, created by `php artisan accounting:provision <school_id>`.
ACCOUNTING_PORT=8087
ACCOUNTING_DB_NAME=skci_accounting
ACCOUNTING_APP_KEY=
ACCOUNTING_APP_URL=http://localhost:8087
# Sub-path prefix for Laravel's asset()/Vite URLs. Set to / only if accounting
# is ever served from its own origin.
ACCOUNTING_ASSET_URL=/accounting

