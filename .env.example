# Root env file for `docker compose up` at the repo root — Docker Compose
# loads this automatically (same directory as docker-compose.yml). Copy to
# `.env` and change the *_SECRET / *_PASSWORD values for anything beyond
# local dev; nothing in docker-compose.yml hardcodes these — see
# docs/CONVENTIONS.md.

# Shared Postgres instance (one server, one database per service — see db-init/).
POSTGRES_USER=sekoci
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5480

# Per-service database names inside the shared instance.
IDENTITY_DB_NAME=skci_identity
ACADEMIC_DB_NAME=skci_academic
ATTENDANCE_DB_NAME=skci_attendance
EXAM_DB_NAME=skci_exam
EVALUATION_DB_NAME=skci_evaluation
REPORT_DB_NAME=skci_report
ADMISSION_DB_NAME=teratai_admission
NOTIFICATION_DB_NAME=teratai_notification
BILLING_DB_NAME=teratai_billing
HR_DB_NAME=teratai_hr
STUDENTLIFE_DB_NAME=teratai_studentlife

# Shared JWT + service-to-service auth (see docs/CONVENTIONS.md "Auth").
SEKOCI_JWT_SECRET=change-me
SEKOCI_INTERNAL_KEY=change-me

# Frontend dev-server origins allowed to call every service (one per
# domain agent's assigned port, see docs/FRONTEND_CONVENTIONS.md).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Service ports.
IDENTITY_PORT=8081
ACADEMIC_PORT=8082
ATTENDANCE_PORT=8083
EXAM_PORT=8084
EVALUATION_PORT=8085
REPORT_PORT=8086
# Teratai PPDB/Portal. 8088 karena 8087 sudah dipakai accounting.
ADMISSION_PORT=8088
# Secret KHUSUS admission untuk token sesi wali PPDB (jangan samakan dengan JWT identity).
ADMISSION_GUARDIAN_JWT_SECRET=change-me
# Secret KHUSUS exam untuk token peserta applicant CBT.
EXAM_PARTICIPANT_SECRET=change-me
# Provider OTP PPDB: "dev" hanya untuk lokal (log ke stdout, dilarang di production).
OTP_PROVIDER=dev

# Portal Orang Tua (fase 2-3-4): port & provider.
NOTIFICATION_PORT=8089
BILLING_PORT=8090
HR_PORT=8092
HR_ENC_KEY=change-me
HR_BLIND_KEY=change-me
# URL internal tiap service sebagaimana dijangkau core untuk callback approval
# (di docker-compose diisi nama service, mis. http://hr:8092). Nilai ini untuk
# menjalankan service langsung di host.
HR_PUBLIC_INTERNAL_URL=http://localhost:8092
BILLING_INTERNAL_URL=http://localhost:8090
ACADEMIC_INTERNAL_URL=http://localhost:8082
STUDENTLIFE_PORT=8094
# Kunci enkripsi data kesehatan (32 byte base64) + blind index. Wajib diisi; nilai di bawah hanya untuk dev.
STUDENTLIFE_ENC_KEY=change-me
STUDENTLIFE_BLIND_KEY=change-me
# dev|noop|unconfigured — "unconfigured" menolak semua kirim (default production).
NOTIFICATION_PROVIDER=unconfigured

# ---- PORTAL ORANG TUA / SPP (legacy, aktifkan bertahap) ----
# Modul sengaja TIDAK di-deploy sebelum fork Teratai terisolasi penuh dari
# infrastruktur Sekoci. Lihat catatan keamanan di README Teratai bila ada.

# Error tracking (see docs/CONVENTIONS.md "Error tracking") — empty by
# default (Sentry SDK no-ops with an empty DSN), same value shared by all
# services; set a real DSN here once you have a Sentry project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Accounting Service (Laravel, served under /accounting/ by `web`).
# It also reads the shared SEKOCI_JWT_SECRET + SEKOCI_INTERNAL_KEY above: the
# former verifies the SSO token, the latter authenticates its feature-flag call
# to identity. Same values as the Go services -- do not duplicate under a new
# name. Its database is multi-tenant: one Postgres SCHEMA per school inside
# ACCOUNTING_DB_NAME, created by `php artisan accounting:provision <school_id>`.
ACCOUNTING_PORT=8087
ACCOUNTING_DB_NAME=skci_accounting
ACCOUNTING_APP_KEY=
ACCOUNTING_APP_URL=http://localhost:8087
# Sub-path prefix for Laravel's asset()/Vite URLs. Set to / only if accounting
# is ever served from its own origin.
ACCOUNTING_ASSET_URL=/accounting

# Core Service (T1: Approval Center, Integration Exceptions, Audit Trail)
CORE_PORT=8091
CORE_DB_NAME=teratai_core
CORE_URL=http://localhost:8091

# NICEPay SNAP Payment Gateway (T6 - billing)
# Empty values activate local simulation/mock. Set real sandbox credentials to test live SNAP endpoints.
NICEPAY_BASE_URL=
NICEPAY_CLIENT_ID=
NICEPAY_CHANNEL_ID=
NICEPAY_CLIENT_SECRET=
NICEPAY_PRIVATE_KEY=
NICEPAY_PUBLIC_KEY=
NICEPAY_STORE_ID=
NICEPAY_CALLBACK_URL=
NICEPAY_RETURN_URL=
NICEPAY_IMAGE_URL=
# T14 payment extensions: other providers read their credentials from
# <credential_ref>_* (e.g. a second NICEPay merchant NICEPAY2_BASE_URL, ...),
# injected by the secret manager; never stored in the DB. Simulator switches
# only work outside production.
PAYMENT_SIM_FAIL_CHARGES=false
PAYMENT_SIM_FAIL_DEBITS=false
GATEWAY_JOURNAL_LOOKBACK_DAYS=7

